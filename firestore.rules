rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ================================
    // КРИТИЧЕСКАЯ БЕЗОПАСНОСТЬ: Финансовые данные
    // ================================
    
    // COGSRecord - ТОЛЬКО ЧТЕНИЕ, создание только через Cloud Functions
    match /users/{userId}/cogsRecords/{recordId} {
      allow read: if isOwnerOrHasPermission(userId, 'VIEW_COGS');
      allow write: if false; // Никого! Только Cloud Functions могут создавать/изменять
    }
    
    // CostSnapshot - ТОЛЬКО ЧТЕНИЕ, создание только через Cloud Functions  
    match /users/{userId}/costSnapshots/{snapshotId} {
      allow read: if isOwnerOrHasPermission(userId, 'VIEW_COST_SNAPSHOTS');
      allow write: if false; // Никого! Только Cloud Functions могут создавать/изменять
    }
    
    // LaborRate - Только Accountant и выше могут изменять
    match /users/{userId}/laborRates/{rateId} {
      allow read: if isOwnerOrHasPermission(userId, 'VIEW_LABOR_RATES');
      allow create, update: if isOwnerOrHasPermission(userId, 'MANAGE_LABOR_RATES');
      allow delete: if isOwnerOrHasPermission(userId, 'DELETE_LABOR_RATES');
    }
    
    // ================================
    // TimeEntry - Дифференцированный доступ по ролям
    // ================================
    match /users/{userId}/timeEntries/{entryId} {
      // Чтение: Владелец записи + менеджеры + PM
      allow read: if isTimeEntryOwner(userId, entryId) || 
                     isOwnerOrHasPermission(userId, 'VIEW_ALL_TIME_ENTRIES');
      
      // Создание: Только владелец может создавать свои записи
      allow create: if request.auth.uid == resource.data.userId &&
                       isOwnerOrHasPermission(userId, 'LOG_TIME');
      
      // Обновление: Владелец может редактировать только черновики
      allow update: if isTimeEntryOwner(userId, entryId) && 
                       resource.data.status == 'draft' &&
                       request.resource.data.status == 'draft';
      
      // Смена статуса: Только менеджеры могут утверждать
      allow update: if (resource.data.status == 'submitted' && 
                       request.resource.data.status in ['approved', 'rejected']) &&
                       isOwnerOrHasPermission(userId, 'APPROVE_TIME_ENTRY');
      
      // Удаление: Только черновики и только владелец
      allow delete: if isTimeEntryOwner(userId, entryId) && 
                       resource.data.status == 'draft';
    }
    
    // ================================
    // EstimateTask - Сметчики и выше
    // ================================
    match /users/{userId}/estimateTasks/{taskId} {
      allow read: if isAuthenticated();
      allow write: if isOwnerOrHasPermission(userId, 'MANAGE_ESTIMATE_TASKS');
      
      // КРИТИЧНО: includeMode может изменять только менеджер или выше
      allow update: if request.resource.data.includeMode != resource.data.includeMode &&
                       isOwnerOrHasPermission(userId, 'MANAGE_INCLUDE_MODE');
    }
    
    // ================================
    // Проекты - Дифференцированный доступ по ролям
    // ================================
    match /users/{userId}/projects/{projectId} {
      allow read: if hasAnyPermission(['VIEW_ALL_PROJECTS', 'VIEW_OWN_PROJECTS']) ||
                     (resource.data.get('assignedUsers', []).hasAny([request.auth.uid]));
      
      allow create: if hasPermission('CREATE_PROJECTS');
      
      allow update: if hasPermission('EDIT_PROJECTS') ||
                       (hasPermission('EDIT_OWN_PROJECTS') && 
                        resource.data.createdBy == request.auth.uid);
      
      allow delete: if hasPermission('DELETE_PROJECTS') && 
                       hasAnyRole(['owner', 'manager']);
    }
    
    // ================================
    // Задачи - Дифференцированный доступ по ролям
    // ================================
    match /users/{userId}/tasks/{taskId} {
      allow read: if hasAnyPermission(['VIEW_ALL_TASKS', 'VIEW_OWN_TASKS']) ||
                     resource.data.assignedTo == request.auth.uid;
      
      allow create: if hasPermission('CREATE_TASKS');
      
      allow update: if hasPermission('EDIT_ALL_TASKS') ||
                       (hasPermission('EDIT_OWN_TASKS') && 
                        resource.data.assignedTo == request.auth.uid);
      
      allow delete: if hasPermission('DELETE_TASKS') && 
                       hasAnyRole(['owner', 'manager', 'pm']);
    }
    
    // ================================
    // Сметы - Контролируемый доступ
    // ================================
    match /users/{userId}/estimates/{estimateId} {
      allow read: if hasPermission('VIEW_ESTIMATES');
      
      allow create: if hasPermission('CREATE_ESTIMATES');
      
      allow update: if hasPermission('EDIT_ESTIMATES') &&
                       (!('status' in request.resource.data) || 
                        hasPermission('APPROVE_ESTIMATES'));
      
      allow delete: if hasPermission('DELETE_ESTIMATES') && 
                       hasAnyRole(['owner', 'manager']);
    }
    
    // ================================
    // Контрагенты - Базовый доступ
    // ================================
    match /users/{userId}/counterparties/{counterpartyId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }
    
    // ================================
    // Сотрудники - Базовый доступ
    // ================================
    match /users/{userId}/employees/{employeeId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }
    
    // ================================
    // Подрядчики (legacy) - Базовый доступ
    // ================================
    match /users/{userId}/contractors/{contractorId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }
    
    // ================================
    // Продукты - Базовый доступ
    // ================================
    match /users/{userId}/products/{productId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }
    
    // ================================
    // Глобальные коллекции (вне пользователей)
    // ================================
    match /employees/{employeeId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }
    
    match /contractors/{contractorId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }
    
    match /projects/{projectId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }
    
    match /tasks/{taskId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }
    
    match /estimates/{estimateId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }
    
    match /counterparties/{counterpartyId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }
    
    match /products/{productId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }
    
    match /notifications/{notificationId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }
    
    match /warehouses/{warehouseId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }
    
    match /stockMovements/{movementId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }
    
    match /shipments/{shipmentId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }
    
    match /invoices/{invoiceId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }
    
    // Также добавим правила для вложенных коллекций уведомлений
    match /users/{userId}/notifications/{notificationId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }
    
    // Правила для других потенциальных вложенных коллекций
    match /users/{userId}/warehouses/{warehouseId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }
    
    match /users/{userId}/stockMovements/{movementId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }
    
    match /users/{userId}/shipments/{shipmentId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }
    
    match /users/{userId}/invoices/{invoiceId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }
    
    // ================================
    // Пользователи и профили (ЗАЩИЩЕННЫЕ)
    // ================================
    match /users/{userId} {
      // Чтение: пользователь может читать свой профиль + администраторы всех
      allow read: if isOwner(userId) || hasPermission('VIEW_ALL_USERS');
      
      // Создание: СТРОГО запрещено! Только через Cloud Functions onUserCreate
      allow create: if false;
      
      // Обновление: только безопасные поля напрямую, остальное через Cloud Functions
      allow update: if isOwner(userId) && 
                       isValidProfileUpdate(request.resource.data, resource.data);
      
      // Удаление: запрещено (только деактивация через Cloud Functions)
      allow delete: if false;
    }
    
    // ================================
    // УНИВЕРСАЛЬНЫЕ ПРАВИЛА для всех остальных коллекций
    // ================================
    
    // Универсальное правило для всех коллекций под пользователем
    match /users/{userId}/{document=**} {
      allow read, write: if isAuthenticated();
    }
    
    // Универсальное правило для всех глобальных коллекций
    match /{document=**} {
      allow read, write: if isAuthenticated();
    }
    
    // ================================
    // ВСПОМОГАТЕЛЬНЫЕ ФУНКЦИИ С CUSTOM CLAIMS
    // ================================
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    
    function isTimeEntryOwner(userId, entryId) {
      return request.auth.uid == resource.data.userId;
    }
    
    // ================================
    // CUSTOM CLAIMS INTEGRATION
    // ================================
    
    /**
     * Получение роли из Custom Claims с фоллбэком на профиль
     * ПРИОРИТЕТ: Custom Claims > Profile fallback
     */
    function getUserRole() {
      return request.auth.token.role != null ? request.auth.token.role : 
             (exists(/databases/$(database)/documents/users/$(request.auth.uid)) ?
              get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role : 
              'pending_approval');
    }
    
    /**
     * Проверка активности пользователя через Custom Claims
     */
    function isUserActive() {
      return request.auth.token.isActive != null ? 
             request.auth.token.isActive == true : 
             isAuthenticated();
    }
    
    /**
     * Проверка роли через Custom Claims
     */
    function hasRole(requiredRole) {
      return isUserActive() && getUserRole() == requiredRole;
    }
    
    /**
     * Проверка любой из ролей
     */
    function hasAnyRole(roles) {
      return isUserActive() && getUserRole() in roles;
    }
    
    /**
     * Проверка разрешения через Custom Claims (ПРИОРИТЕТНЫЙ МЕТОД)
     * БЕЗОПАСНОСТЬ: Серверные Custom Claims всегда имеют приоритет
     */
    function hasPermission(permission) {
      if (!isUserActive()) {
        return false;
      }
      
      // Owner всегда имеет доступ
      if (getUserRole() == 'owner') {
        return true;
      }
      
      // Проверяем permissions из Custom Claims (установленные на сервере)
      if (request.auth.token.permissions != null) {
        return permission in request.auth.token.permissions;
      }
      
      // Фоллбэк на статические разрешения роли (для совместимости)
      return permission in getRolePermissions(getUserRole());
    }
    
    /**
     * Расширенная проверка списка разрешений (любое из)
     */
    function hasAnyPermission(permissions) {
      if (!isUserActive()) {
        return false;
      }
      
      if (getUserRole() == 'owner') {
        return true;
      }
      
      // Проверяем через Custom Claims permissions
      if (request.auth.token.permissions != null) {
        return permissions.hasAny(request.auth.token.permissions);
      }
      
      // Фоллбэк
      let rolePermissions = getRolePermissions(getUserRole());
      return permissions.hasAny(rolePermissions);
    }
    
    /**
     * Проверка разрешений пользователя (основная функция)
     */
    function isOwnerOrHasPermission(userId, permission) {
      return isOwner(userId) || hasPermission(permission);
    }
    
    /**
     * Проверка административных прав
     */
    function isAdmin() {
      return hasAnyRole(['owner', 'manager']);
    }
    
    /**
     * Проверка финансовых прав
     */
    function hasFinancialRights() {
      return hasAnyRole(['owner', 'accountant']);
    }
    
    /**
     * Мапинг ролей к разрешениям (фоллбэк для совместимости)
     * ВАЖНО: Это используется только если нет Custom Claims permissions
     */
    function getRolePermissions(role) {
      return role == 'owner' ? [
        // Owner имеет все разрешения
        'VIEW_ALL_TIME_ENTRIES', 'APPROVE_TIME_ENTRY', 'MANAGE_PROJECTS',
        'MANAGE_ESTIMATE_TASKS', 'VIEW_COGS', 'VIEW_COST_SNAPSHOTS',
        'VIEW_LABOR_RATES', 'MANAGE_LABOR_RATES', 'DELETE_LABOR_RATES',
        'LOG_TIME', 'MANAGE_INCLUDE_MODE', 'VIEW_AUDIT_LOGS',
        // RBAC разрешения
        'MANAGE_ROLES', 'VIEW_ROLES', 'MANAGE_USERS', 'VIEW_USER_ROLES',
        'MANAGE_GROUPS', 'VIEW_GROUPS', 'VIEW_TEMPORARY_ROLES', 'VIEW_DELEGATIONS',
        'VIEW_USER_PERMISSIONS', 'VIEW_RBAC_STATS'
      ] :
      role == 'manager' ? [
        'VIEW_ALL_TIME_ENTRIES', 'APPROVE_TIME_ENTRY', 'MANAGE_PROJECTS',
        'MANAGE_ESTIMATE_TASKS', 'VIEW_COGS', 'VIEW_COST_SNAPSHOTS',
        'VIEW_LABOR_RATES', 'LOG_TIME',
        // RBAC разрешения для менеджеров
        'VIEW_ROLES', 'MANAGE_USERS', 'VIEW_USER_ROLES', 'MANAGE_GROUPS', 
        'VIEW_GROUPS', 'VIEW_TEMPORARY_ROLES'
      ] :
      role == 'pm' ? [
        'VIEW_ALL_TIME_ENTRIES', 'APPROVE_TIME_ENTRY', 'MANAGE_PROJECTS',
        'VIEW_COGS', 'LOG_TIME'
      ] :
      role == 'accountant' ? [
        'VIEW_ALL_TIME_ENTRIES', 'MANAGE_LABOR_RATES', 'DELETE_LABOR_RATES',
        'VIEW_COGS', 'VIEW_COST_SNAPSHOTS', 'VIEW_LABOR_RATES', 'APPROVE_TIME_ENTRY'
      ] :
      role == 'estimator' ? [
        'MANAGE_ESTIMATE_TASKS', 'LOG_TIME', 'VIEW_COGS'
      ] :
      role == 'employee' ? [
        'LOG_TIME'
      ] :
      role == 'contractor' ? [
        'LOG_TIME'
      ] :
      role == 'field' ? [
        'LOG_TIME'
      ] : 
      role == 'pending_approval' ? [] :
      role == 'deactivated' ? [] :
      [];
    }
    
    // ================================
    // НОВЫЕ КОЛЛЕКЦИИ ДЛЯ ENTERPRISE БЕЗОПАСНОСТИ
    // ================================
    
    // Audit Logs - Неизменяемые логи системных событий
    match /auditLogs/{logId} {
      allow read: if hasPermission('VIEW_AUDIT_LOGS');
      allow write: if false; // Только Cloud Functions могут создавать аудит логи
    }
    
    // ================================
    // ДИНАМИЧЕСКАЯ СИСТЕМА RBAC 
    // ================================
    
    // Динамические роли - только администраторы могут управлять
    match /rbac_roles/{roleId} {
      allow read: if hasPermission('VIEW_ROLES');
      allow create, update: if hasPermission('MANAGE_ROLES');
      allow delete: if hasPermission('MANAGE_ROLES') && 
                       !resource.data.isSystem; // Системные роли нельзя удалять
    }
    
    // Профили RBAC пользователей - только администраторы и владелец
    match /user_rbac_profiles/{userId} {
      allow read: if isOwner(userId) || hasPermission('VIEW_USER_ROLES');
      allow write: if false; // Только Cloud Functions могут изменять RBAC профили
    }
    
    // Группы пользователей - только администраторы
    match /user_groups/{groupId} {
      allow read: if hasPermission('VIEW_GROUPS');
      allow create, update: if hasPermission('MANAGE_GROUPS');
      allow delete: if hasPermission('MANAGE_GROUPS');
    }
    
    // Временные назначения ролей - только администраторы и владелец
    match /temporary_role_assignments/{assignmentId} {
      allow read: if isOwner(resource.data.userId) || hasPermission('VIEW_TEMPORARY_ROLES');
      allow write: if false; // Только Cloud Functions управляют временными ролями
    }
    
    // Делегирование полномочий - владелец и получатель могут читать
    match /authority_delegations/{delegationId} {
      allow read: if isOwner(resource.data.delegatorId) || 
                     isOwner(resource.data.delegateId) ||
                     hasPermission('VIEW_DELEGATIONS');
      allow write: if false; // Только Cloud Functions управляют делегированием
    }
    
    // Вычисленные разрешения (кэш) - только для владельца
    match /computed_permissions/{userId} {
      allow read: if isOwner(userId) || hasPermission('VIEW_USER_PERMISSIONS');
      allow write: if false; // Только Cloud Functions пересчитывают разрешения
    }
    
    // Статистика RBAC - только администраторы
    match /rbac_statistics/{statId} {
      allow read: if hasPermission('VIEW_RBAC_STATS');
      allow write: if false; // Только Cloud Functions генерируют статистику
    }
    
    // ================================
    // SECURITY VALIDATION FUNCTIONS
    // ================================
    
    /**
     * Валидация обновления профиля - только безопасные поля
     * КРИТИЧНО: Блокируем все финансовые и административные поля
     */
    function isValidProfileUpdate(newData, currentData) {
      // ЗАПРЕЩЕННЫЕ поля (могут изменять только Cloud Functions)
      let hasForbiddenChanges = (
        ('role' in newData && newData.role != currentData.role) ||
        ('isActive' in newData && newData.isActive != currentData.isActive) ||
        ('hourlyRate' in newData && newData.hourlyRate != currentData.hourlyRate) ||
        ('employeeId' in newData && newData.employeeId != currentData.employeeId) ||
        ('contractorId' in newData && newData.contractorId != currentData.contractorId) ||
        ('createdAt' in newData && newData.createdAt != currentData.createdAt) ||
        ('deactivatedAt' in newData) ||
        ('deactivatedBy' in newData) ||
        ('deactivationReason' in newData)
      );
      
      // РАЗРЕШЕННЫЕ поля (пользователь может изменять сам)
      let allowedFields = [
        'displayName', 'phoneNumber', 'whatsappPhone', 'telegramUsername',
        'preferredNotificationChannel', 'updatedAt', 'lastLogin'
      ];
      
      // Проверяем что изменяются только разрешенные поля
      let onlyAllowedFields = (
        // Проверка основных полей
        (!('role' in newData) || newData.role == currentData.role) &&
        (!('permissions' in newData) || newData.permissions == currentData.permissions) &&
        (!('isActive' in newData) || newData.isActive == currentData.isActive) &&
        (!('companyId' in newData) || newData.companyId == currentData.companyId) &&
        (!('department' in newData) || newData.department == currentData.department) &&
        (!('hireDate' in newData) || newData.hireDate == currentData.hireDate) &&
        (!('deactivationReason' in newData) || newData.deactivationReason == currentData.deactivationReason) &&
        (!('email' in newData) || newData.email == currentData.email)
      );
      
      return !hasForbiddenChanges && onlyAllowedFields;
    }
    
    /**
     * Проверка прав на изменение чувствительных данных
     */
    function canModifySensitiveData(userId) {
      return isOwner(userId) && hasPermission('MANAGE_USERS') ||
             hasRole('owner');
    }
    
    // ================================
    // БЛОКИРОВКА: Системные коллекции только для Cloud Functions
    // ================================
    
    // Системные логи - полная блокировка
    match /systemLogs/{logId} {
      allow read, write: if false;
    }
    
    // Внутренние метрики - только чтение для админов
    match /metrics/{metricId} {
      allow read: if hasRole('owner');
      allow write: if false;
    }
  }
}