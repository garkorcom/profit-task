rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Функции безопасности
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    
    // Валидация эмоциональных уровней (1-5)
    function isValidEmotionLevel(level) {
      return level is int && level >= 1 && level <= 5;
    }
    
    // Валидация длины заметок
    function isValidNotes(notes) {
      return notes == null || (notes is string && notes.size() <= 1000);
    }
    
    // Валидация типа контекста
    function isValidContextType(contextType) {
      return contextType in ['timeEntry', 'task', 'project', 'event', 'manual'];
    }
    
    // Валидация временных меток (не более 1 часа в будущем)
    function isValidTimestamp(ts) {
      return ts is int && ts <= (request.time.toMillis() + 3600000) && ts > 0;
    }
    
    // Валидация тегов (максимум 5 тегов, каждый до 50 символов)
    function isValidTags(tags) {
      return tags is list && 
             tags.size() <= 5 &&
             tags.hasOnly(['string']);
    }
    
    // ЭМОЦИОНАЛЬНЫЕ ЛОГИ - строгая изоляция по userId
    match /emotionLogs/{logId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && 
                   resource.data.userId == request.auth.uid &&
                   request.resource.data.userId == request.auth.uid &&
                   isValidEmotionLevel(request.resource.data.level) &&
                   isValidNotes(request.resource.data.get('notes', null)) &&
                   isValidTags(request.resource.data.tags);
      allow create: if isAuthenticated() && 
                   request.resource.data.userId == request.auth.uid &&
                   isValidEmotionLevel(request.resource.data.level) &&
                   isValidNotes(request.resource.data.get('notes', null)) &&
                   isValidContextType(request.resource.data.context.type) &&
                   isValidTimestamp(request.resource.data.ts) &&
                   isValidTags(request.resource.data.tags);
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }
    
    // ДНЕВНАЯ СТАТИСТИКА ЭМОЦИЙ - строгая изоляция по userId
    match /emotionDailyStats/{statsId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow write: if isAuthenticated() && 
                  resource.data.userId == request.auth.uid &&
                  request.resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && 
                   request.resource.data.userId == request.auth.uid;
    }
    
    // ЦЕЛИ РАЗВИТИЯ - строгая изоляция по userId
    match /goals/{goalId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow write: if isAuthenticated() && 
                  resource.data.userId == request.auth.uid &&
                  request.resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && 
                   request.resource.data.userId == request.auth.uid &&
                   request.resource.data.category in ['professional', 'learning', 'personal', 'health'] &&
                   request.resource.data.status in ['draft', 'active', 'paused', 'completed', 'cancelled'] &&
                   request.resource.data.priority in ['low', 'medium', 'high'];
    }
    
    // СОБЫТИЯ КАЛЕНДАРЯ - строгая изоляция по userId  
    match /calendarEvents/{eventId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow write: if isAuthenticated() && 
                  resource.data.userId == request.auth.uid &&
                  request.resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && 
                   request.resource.data.userId == request.auth.uid;
    }
    
    // Пользователи - только владелец может читать свой профиль
    // Но разрешаем список пользователей для поиска публичных смет
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId);
      allow list: if true; // Разрешаем получать список пользователей для поиска публичных смет
    }
    
    // Проекты - изоляция по userId в подколлекции users/{userId}/projects  
    match /users/{userId}/projects/{projectId} {
      allow read, write: if isOwner(userId);
    }
    
    // Задачи - изоляция по userId в подколлекции users/{userId}/tasks
    match /users/{userId}/tasks/{taskId} {
      allow read, write: if isOwner(userId);
    }
    
    // Записи времени - изоляция по userId в подколлекции users/{userId}/timeEntries
    match /users/{userId}/timeEntries/{entryId} {
      allow read, write: if isOwner(userId);
    }
    
    // Сметы - изоляция по userId в подколлекции users/{userId}/estimates  
    match /users/{userId}/estimates/{estimateId} {
      // Публичный доступ для смет со статусом "sent" или "accepted"
      allow read: if resource.data.status in ['sent', 'accepted'] || isOwner(userId);
      allow write: if isOwner(userId);
      
      // Элементы смет - подколлекция items
      match /items/{itemId} {
        allow read: if get(/databases/$(database)/documents/users/$(userId)/estimates/$(estimateId)).data.status in ['sent', 'accepted'] || isOwner(userId);
        allow write: if isOwner(userId);
      }
      
      // Коммуникации по смете - подколлекция communications  
      match /communications/{commId} {
        allow read: if get(/databases/$(database)/documents/users/$(userId)/estimates/$(estimateId)).data.status in ['sent', 'accepted'] || isOwner(userId);
        allow write: if isOwner(userId);
      }
    }
    
    // Сметы V2 - изоляция по userId в подколлекции users/{userId}/estimatesV2
    match /users/{userId}/estimatesV2/{estimateId} {
      // Публичный доступ для смет со статусом "sent" или "accepted"
      allow read: if resource.data.status in ['sent', 'accepted'] || isOwner(userId);
      allow write: if isOwner(userId);
      
      // Элементы смет V2 - подколлекция items
      match /items/{itemId} {
        allow read: if get(/databases/$(database)/documents/users/$(userId)/estimatesV2/$(estimateId)).data.status in ['sent', 'accepted'] || isOwner(userId);
        allow write: if isOwner(userId);
      }
      
      // Коммуникации по смете V2 - подколлекция communications  
      match /communications/{commId} {
        allow read: if get(/databases/$(database)/documents/users/$(userId)/estimatesV2/$(estimateId)).data.status in ['sent', 'accepted'] || isOwner(userId);
        allow write: if isOwner(userId);
      }
    }
    
    // Категории смет - изоляция по userId
    match /users/{userId}/estimateCategories/{categoryId} {
      allow read, write: if isOwner(userId);
    }
    
    // Задачи смет - изоляция по userId
    match /users/{userId}/estimateTasks/{taskId} {
      allow read, write: if isOwner(userId);
    }
    
    // НОМЕНКЛАТУРА - унифицированная система товаров, услуг и комплектов
    match /users/{userId}/items/{itemId} {
      allow read, write: if isOwner(userId);
    }
    
    // СКЛАДЫ И СКЛАДСКИЕ ОПЕРАЦИИ
    match /users/{userId}/warehouses/{warehouseId} {
      allow read, write: if isOwner(userId);
      
      // Подколлекции склада
      match /bins/{binId} {
        allow read, write: if isOwner(userId);
      }
      
      match /stockLots/{lotId} {
        allow read, write: if isOwner(userId);
      }
      
      match /stockBalance/{balanceId} {
        allow read, write: if isOwner(userId);
      }
      
      match /transactions/{transactionId} {
        allow read, write: if isOwner(userId);
      }
      
      match /ledger/{entryId} {
        allow read, write: if isOwner(userId);
      }
    }
    
    // Глобальные складские коллекции
    match /users/{userId}/stockReservations/{reservationId} {
      allow read, write: if isOwner(userId);
    }
    
    match /users/{userId}/reservations/{reservationId} {
      allow read, write: if isOwner(userId);
    }
    
    match /users/{userId}/inventoryCounts/{countId} {
      allow read, write: if isOwner(userId);
      
      // Строки инвентаризации
      match /lines/{lineId} {
        allow read, write: if isOwner(userId);
      }
    }
    
    // ИНТЕГРАЦИЯ СМЕТ СО СКЛАДОМ
    match /users/{userId}/estimateItemWarehouse/{linkId} {
      allow read, write: if isOwner(userId);
    }
    
    // КОНТРАГЕНТЫ - изоляция по userId в подколлекции users/{userId}/counterparties
    match /users/{userId}/counterparties/{counterpartyId} {
      allow read, write: if isOwner(userId);
    }
    
    // ГЛОБАЛЬНЫЙ ИНДЕКС КОНТРАГЕНТОВ - для проверки дубликатов
    match /counterparties_index/{indexId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
    }
    
    // ==================== СИСТЕМА ПОСТАНОВКИ ЗАДАЧ ====================
    
    // Функции для проверки ролей пользователей
    function hasAdminRights() {
      return request.auth.token.role in ['owner', 'manager'];
    }
    
    function hasManagerRights() {
      return request.auth.token.role in ['owner', 'manager', 'pm'];
    }
    
    function canAssignTasks() {
      return request.auth.token.role in ['owner', 'manager', 'pm', 'estimator'];
    }
    
    function isFieldWorker() {
      return request.auth.token.role in ['field', 'employee', 'contractor'];
    }
    
    // Валидация статуса задачи
    function isValidTaskStatus(status) {
      return status in ['assigned', 'acknowledged', 'started', 'in_progress', 'paused', 'completed', 'verified', 'approved', 'rejected'];
    }
    
    // Валидация приоритета задачи
    function isValidTaskPriority(priority) {
      return priority in ['low', 'medium', 'high', 'urgent'];
    }
    
    // Проверка разрешенных полей для обновления исполнителем
    function onlyUpdatingAllowedEmployeeFields() {
      let allowedFields = ['status', 'acknowledgedAt', 'startedAt', 'completedAt', 'currentTimeEntryId', 
                          'totalActiveDuration', 'totalPauseDuration', 'startLocation', 'endLocation',
                          'startPhotos', 'completionPhotos', 'pauseReason', 'unreadCount', 'lastCommentAt', 
                          'lastCommentBy', 'updatedAt'];
      
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(allowedFields);
    }
    
    // ОСНОВНАЯ КОЛЛЕКЦИЯ ЗАДАЧ ПОСТАНОВКИ
    match /assignmentTasks/{taskId} {
      // ЧТЕНИЕ: назначенный сотрудник, создатель, админы/менеджеры
      allow read: if isAuthenticated() && (
        resource.data.assignedTo == request.auth.uid ||
        resource.data.assignedBy == request.auth.uid ||
        hasManagerRights()
      );
      
      // СОЗДАНИЕ: только те, кто может назначать задачи
      allow create: if isAuthenticated() && 
                   canAssignTasks() &&
                   request.resource.data.assignedBy == request.auth.uid &&
                   isValidTaskStatus(request.resource.data.status) &&
                   isValidTaskPriority(request.resource.data.priority) &&
                   request.resource.data.status == 'assigned'; // Новые задачи всегда со статусом 'assigned'
      
      // ОБНОВЛЕНИЕ:
      // 1. Назначенный сотрудник может менять разрешенные поля (статус, временные метки, фото, локацию)
      // 2. Создатель/менеджер может менять любые поля
      allow update: if isAuthenticated() && (
        // Сотрудник может обновлять только разрешенные поля
        (resource.data.assignedTo == request.auth.uid && 
         onlyUpdatingAllowedEmployeeFields() &&
         isValidTaskStatus(request.resource.data.status)) ||
        // Создатель может обновлять все поля
        resource.data.assignedBy == request.auth.uid ||
        // Админы/менеджеры могут обновлять все поля
        hasManagerRights()
      );
      
      // УДАЛЕНИЕ: только создатель или админы
      allow delete: if isAuthenticated() && (
        resource.data.assignedBy == request.auth.uid ||
        hasAdminRights()
      );
      
      // ==================== ПОДКОЛЛЕКЦИЯ КОММЕНТАРИЕВ ====================
      match /comments/{commentId} {
        // ЧТЕНИЕ: участники задачи (назначенный, создатель) + менеджеры
        allow read: if isAuthenticated() && (
          get(/databases/$(database)/documents/assignmentTasks/$(taskId)).data.assignedTo == request.auth.uid ||
          get(/databases/$(database)/documents/assignmentTasks/$(taskId)).data.assignedBy == request.auth.uid ||
          hasManagerRights()
        );
        
        // СОЗДАНИЕ: участники задачи могут добавлять комментарии
        allow create: if isAuthenticated() && 
                     request.resource.data.userId == request.auth.uid &&
                     request.resource.data.taskId == taskId &&
                     (get(/databases/$(database)/documents/assignmentTasks/$(taskId)).data.assignedTo == request.auth.uid ||
                      get(/databases/$(database)/documents/assignmentTasks/$(taskId)).data.assignedBy == request.auth.uid ||
                      hasManagerRights());
        
        // ОБНОВЛЕНИЕ: только автор комментария (для пометки как прочитанного)
        allow update: if isAuthenticated() && 
                     resource.data.userId == request.auth.uid;
        
        // УДАЛЕНИЕ: автор комментария или админы
        allow delete: if isAuthenticated() && (
          resource.data.userId == request.auth.uid ||
          hasAdminRights()
        );
      }
    }
    
    // ==================== ИНДЕКСЫ И СТАТИСТИКА ЗАДАЧ ====================
    
    // Индекс задач по пользователю (для быстрого поиска "мои задачи")
    match /taskAssignmentIndex/{userId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == userId ||
        hasManagerRights()
      );
      allow write: if false; // Только через Cloud Functions
    }
    
    // Статистика выполнения задач
    match /taskStatistics/{userId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == userId ||
        hasManagerRights()
      );
      allow write: if false; // Только через Cloud Functions
    }
    
    // DEVELOPMENT: Allow all authenticated users - TODO: Restrict in production
    match /{document=**} {
      allow read, write: if isAuthenticated();
    }
  }
}