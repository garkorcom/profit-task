rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Разрешаем чтение всем авторизованным пользователям
    match /{allPaths=**} {
      allow read: if request.auth != null;
    }
    
    // Правила для фотографий учета времени
    match /timeTracking/{userId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Правила для фотографий задач
    match /tasks/{userId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Правила для документов и вложений
    match /documents/{userId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Правила для аватаров пользователей
    match /avatars/{userId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
