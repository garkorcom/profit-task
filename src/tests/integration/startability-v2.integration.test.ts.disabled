/**
 * ============================================================================
 * STARTABILITY V2 INTEGRATION TESTS - Technical Requirements Implementation
 * ============================================================================
 * 
 * Comprehensive integration tests for Startability V2 system covering all
 * acceptance criteria from the technical requirements document.
 * 
 * @author Senior Full-Stack Engineer + UX Architect
 * @version 1.0.0 - Technical Requirements
 * @feature estimates.startability_v1
 */

import { describe, it, expect, beforeEach, afterEach, jest } from '@jest/globals';
import { render, screen, fireEvent, waitFor, within } from '@testing-library/react';
import userEvent from '@testing-library/user-event';
import { act } from 'react-dom/test-utils';

// Mock Firebase functions
jest.mock('../../firebase/firebase', () => ({
  functions: {}
}));

jest.mock('firebase/functions', () => ({
  httpsCallable: jest.fn(() => jest.fn())
}));

// Test utilities
import { 
  createMockEstimate,
  createMockProject,
  createMockStartabilitySnapshot,
  createMockItemStartabilities,
  TestWrapper 
} from '../fixtures/startability-fixtures';

// Components under test
import EstimateConstructor from '../../pages/estimates/EstimateConstructor';
import { ActionableComponentsFactory } from '../../components/startability/ActionableComponentsFactory';
import { StartabilityHeader } from '../../components/startability/StartabilityHeader';
import ServicesBlock from '../../components/estimates/blocks/ServicesBlock';

// API and utils
import * as startabilityV2Api from '../../api/startabilityV2Api';
import { analyzeGlobalActionBlocking } from '../../utils/globalActionBlocking';
import { StartabilityReport, ItemStartability, BlockerReason, ResolutionAction } from '../../types/startability.types';

// =====================================================
// TEST SETUP & FIXTURES
// =====================================================

const mockV2ApiResponse: StartabilityReport = {
  projectId: 'test-project-id',
  isProjectStartable: false,
  itemsStartability: {
    'service-1': {
      itemId: 'service-1',
      summaryStatus: 'BLOCKED',
      blockers: [
        {
          code: 'MISSING_ASSIGNMENT',
          category: 'Task',
          description: 'Услуга не назначена исполнителю',
          severity: 'CRITICAL',
          resolutionAction: {
            type: 'ASSIGN_USER',
            label: 'Назначить исполнителя',
            apiEndpoint: '/api/v2/tasks/assign',
            contextData: {
              taskId: 'service-1',
              estimateId: 'test-estimate-id',
              allowedRoles: ['executor', 'contractor']
            }
          }
        }
      ]
    },
    'service-2': {
      itemId: 'service-2',
      summaryStatus: 'WARNING',
      blockers: [
        {
          code: 'MISSING_COUNTERPARTY_APPROVAL',
          category: 'Business',
          description: 'Ожидается утверждение клиента',
          severity: 'WARNING',
          resolutionAction: {
            type: 'REQUEST_APPROVAL',
            label: 'Запросить одобрение',
            apiEndpoint: '/api/v2/approvals/request',
            contextData: {
              projectId: 'test-project-id',
              estimateId: 'test-estimate-id',
              approvalType: 'estimate'
            }
          }
        }
      ]
    },
    'service-3': {
      itemId: 'service-3',
      summaryStatus: 'READY',
      blockers: []
    }
  }
};

describe('Startability V2 Integration Tests', () => {
  let mockGetStartabilityAnalysis: jest.MockedFunction<typeof startabilityV2Api.getStartabilityAnalysis>;
  let mockExecuteResolutionAction: jest.MockedFunction<typeof startabilityV2Api.executeResolutionAction>;
  
  beforeEach(() => {
    // Mock API calls
    mockGetStartabilityAnalysis = jest.fn().mockResolvedValue(mockV2ApiResponse);
    mockExecuteResolutionAction = jest.fn().mockResolvedValue({
      success: true,
      message: 'Action executed successfully'
    });
    
    jest.spyOn(startabilityV2Api, 'getStartabilityAnalysis').mockImplementation(mockGetStartabilityAnalysis);
    jest.spyOn(startabilityV2Api, 'executeResolutionAction').mockImplementation(mockExecuteResolutionAction);
    
    // Mock feature flags
    jest.doMock('../../utils/featureFlags', () => ({
      useFeatureFlag: jest.fn(() => ({ enabled: true }))
    }));
  });

  afterEach(() => {
    jest.clearAllMocks();
  });

  // =====================================================
  // TZ ACCEPTANCE CRITERIA TESTS
  // =====================================================

  describe('AC1: Master-Detail UI Pattern Implementation', () => {
    it('should display startability indicators in estimate item rows', async () => {
      const mockEstimate = createMockEstimate();
      const mockProps = {
        estimate: mockEstimate,
        block: { key: 'services' as const, status: 'complete' as const, data: {}, dataVersion: 1, updatedAt: new Date().toISOString() },
        onSave: jest.fn(),
        saving: false,
        itemStartabilities: mockV2ApiResponse.itemsStartability,
        onStartabilityClick: jest.fn()
      };

      render(
        <TestWrapper>
          <ServicesBlock {...mockProps} />
        </TestWrapper>
      );

      // Wait for startability cells to appear
      await waitFor(() => {
        expect(screen.getByTestId('startability-cell-service-1')).toBeInTheDocument();
      });

      // Verify blocked item shows critical status
      const blockedCell = screen.getByTestId('startability-cell-service-1');
      expect(blockedCell).toHaveAttribute('data-status', 'BLOCKED');
      expect(within(blockedCell).getByLabelText(/критическая проблема/i)).toBeInTheDocument();

      // Verify warning item shows warning status  
      const warningCell = screen.getByTestId('startability-cell-service-2');
      expect(warningCell).toHaveAttribute('data-status', 'WARNING');
      expect(within(warningCell).getByLabelText(/предупреждение/i)).toBeInTheDocument();

      // Verify ready item shows success status
      const readyCell = screen.getByTestId('startability-cell-service-3');
      expect(readyCell).toHaveAttribute('data-status', 'READY');
      expect(within(readyCell).getByLabelText(/готов/i)).toBeInTheDocument();
    });

    it('should open detail dialog when startability cell is clicked', async () => {
      const user = userEvent.setup();
      const mockEstimate = createMockEstimate();
      const onStartabilityClick = jest.fn();
      
      const mockProps = {
        estimate: mockEstimate,
        block: { key: 'services' as const, status: 'complete' as const, data: {}, dataVersion: 1, updatedAt: new Date().toISOString() },
        onSave: jest.fn(),
        saving: false,
        itemStartabilities: mockV2ApiResponse.itemsStartability,
        onStartabilityClick
      };

      render(
        <TestWrapper>
          <ServicesBlock {...mockProps} />
        </TestWrapper>
      );

      // Click on blocked item's startability cell
      const blockedCell = await screen.findByTestId('startability-cell-service-1');
      await user.click(blockedCell);

      // Verify click handler was called
      expect(onStartabilityClick).toHaveBeenCalledWith('service-1');

      // Verify detail dialog opens
      await waitFor(() => {
        expect(screen.getByRole('dialog')).toBeInTheDocument();
        expect(screen.getByText('Стартуемость позиции')).toBeInTheDocument();
      });

      // Verify blocker details are shown
      expect(screen.getByText('MISSING_ASSIGNMENT')).toBeInTheDocument();
      expect(screen.getByText('Услуга не назначена исполнителю')).toBeInTheDocument();
    });
  });

  describe('AC2: Actionable Components Factory Integration', () => {
    it('should render appropriate resolution action components', async () => {
      const user = userEvent.setup();
      
      const testResolutionAction: ResolutionAction = {
        type: 'ASSIGN_USER',
        label: 'Назначить исполнителя',
        apiEndpoint: '/api/v2/tasks/assign',
        contextData: {
          taskId: 'service-1',
          estimateId: 'test-estimate-id'
        }
      };

      const onExecute = jest.fn();

      render(
        <TestWrapper>
          <ActionableComponentsFactory
            resolutionAction={testResolutionAction}
            onExecute={onExecute}
          />
        </TestWrapper>
      );

      // Verify ASSIGN_USER component renders
      const assignButton = screen.getByRole('button', { name: /назначить исполнителя/i });
      expect(assignButton).toBeInTheDocument();

      // Click assign button to open dialog
      await user.click(assignButton);

      // Verify assignment dialog opens
      await waitFor(() => {
        expect(screen.getByText('Назначить исполнителя')).toBeInTheDocument();
        expect(screen.getByText('Выберите исполнителя')).toBeInTheDocument();
      });

      // Select an assignee and execute action
      const userSelect = screen.getByLabelText('Выберите исполнителя');
      await user.click(userSelect);
      
      const assigneeOption = await screen.findByText('Иван Петров');
      await user.click(assigneeOption);

      const executeButton = screen.getByRole('button', { name: /назначить задачу/i });
      await user.click(executeButton);

      // Verify API call was made
      await waitFor(() => {
        expect(mockExecuteResolutionAction).toHaveBeenCalledWith(
          testResolutionAction,
          expect.objectContaining({
            assigneeId: expect.any(String)
          })
        );
      });
    });

    it('should handle REQUEST_APPROVAL action type', async () => {
      const user = userEvent.setup();
      
      const approvalAction: ResolutionAction = {
        type: 'REQUEST_APPROVAL',
        label: 'Запросить одобрение',
        apiEndpoint: '/api/v2/approvals/request',
        contextData: {
          projectId: 'test-project-id',
          estimateId: 'test-estimate-id',
          approvalType: 'estimate'
        }
      };

      render(
        <TestWrapper>
          <ActionableComponentsFactory
            resolutionAction={approvalAction}
            onExecute={jest.fn()}
          />
        </TestWrapper>
      );

      const approvalButton = screen.getByRole('button', { name: /запросить одобрение/i });
      await user.click(approvalButton);

      // Verify approval request dialog
      await waitFor(() => {
        expect(screen.getByText('Запрос на утверждение')).toBeInTheDocument();
        expect(screen.getByLabelText('Текст запроса')).toBeInTheDocument();
      });

      // Fill in approval message
      const messageField = screen.getByLabelText('Текст запроса');
      await user.type(messageField, 'Пожалуйста, утвердите смету для начала работ');

      // Submit approval request
      const submitButton = screen.getByRole('button', { name: /отправить запрос/i });
      await user.click(submitButton);

      // Verify API call
      await waitFor(() => {
        expect(mockExecuteResolutionAction).toHaveBeenCalledWith(
          approvalAction,
          expect.objectContaining({
            message: 'Пожалуйста, утвердите смету для начала работ'
          })
        );
      });
    });
  });

  describe('AC3: Global Action Blocking Logic', () => {
    it('should block critical actions when critical issues exist', async () => {
      const snapshot = createMockStartabilitySnapshot({
        overall: 'blocked',
        reasons: [
          {
            code: 'MISSING_ASSIGNMENT',
            category: 'PERMISSIONS',
            message: 'Task not assigned',
            severity: 'critical',
            detectedAt: new Date(),
            autoResolvable: false
          }
        ]
      });

      const blockingState = analyzeGlobalActionBlocking(snapshot, mockV2ApiResponse.itemsStartability);

      // Verify critical actions are blocked
      expect(blockingState.hasCriticalIssues).toBe(true);
      expect(blockingState.isBlocked('SEND_ESTIMATE')).toBe(true);
      expect(blockingState.isBlocked('CONVERT_TO_CONTRACT')).toBe(true);
      expect(blockingState.isBlocked('START_WORK')).toBe(true);

      // Verify non-critical actions remain allowed
      expect(blockingState.isBlocked('EXPORT_ESTIMATE')).toBe(false);
      expect(blockingState.isBlocked('DUPLICATE_ESTIMATE')).toBe(false);

      // Verify blocking reasons are provided
      expect(blockingState.getReason('SEND_ESTIMATE')).toContain('критические проблемы');
      expect(blockingState.getTooltip('SEND_ESTIMATE')).toContain('Критических проблем:');
    });

    it('should allow actions when only warnings exist', async () => {
      const snapshot = createMockStartabilitySnapshot({
        overall: 'attention',
        reasons: [
          {
            code: 'MISSING_COUNTERPARTY_APPROVAL',
            category: 'BUSINESS',
            message: 'Approval pending',
            severity: 'warning',
            detectedAt: new Date(),
            autoResolvable: false
          }
        ]
      });

      const blockingState = analyzeGlobalActionBlocking(snapshot, mockV2ApiResponse.itemsStartability);

      // Verify only warning-sensitive actions are blocked
      expect(blockingState.hasWarningIssues).toBe(true);
      expect(blockingState.hasCriticalIssues).toBe(false);
      expect(blockingState.isBlocked('SEND_ESTIMATE')).toBe(false);
      expect(blockingState.isBlocked('CONVERT_TO_CONTRACT')).toBe(false);
      expect(blockingState.isBlocked('START_WORK')).toBe(true); // START_WORK blocks on warnings
    });
  });

  describe('AC4: StartabilityHeader Integration', () => {
    it('should disable send estimate button when critical issues exist', async () => {
      const snapshot = createMockStartabilitySnapshot({
        overall: 'blocked',
        reasons: [{
          code: 'MISSING_ASSIGNMENT',
          category: 'PERMISSIONS', 
          message: 'Critical issue',
          severity: 'critical',
          detectedAt: new Date(),
          autoResolvable: false
        }]
      });

      const onSendEstimate = jest.fn();
      const onConvertToContract = jest.fn();

      render(
        <TestWrapper>
          <StartabilityHeader
            snapshot={snapshot}
            onSendEstimate={onSendEstimate}
            onConvertToContract={onConvertToContract}
            showActions={true}
          />
        </TestWrapper>
      );

      // Verify buttons are disabled
      const sendButton = screen.getByTestId('send-estimate-button');
      const convertButton = screen.getByTestId('convert-contract-button');

      expect(sendButton).toBeDisabled();
      expect(convertButton).toBeDisabled();

      // Verify tooltips show blocking reasons
      expect(sendButton.closest('span')).toHaveAttribute('title');
    });

    it('should enable actions when no critical issues exist', async () => {
      const snapshot = createMockStartabilitySnapshot({
        overall: 'ready',
        reasons: []
      });

      const onSendEstimate = jest.fn();

      render(
        <TestWrapper>
          <StartabilityHeader
            snapshot={snapshot}
            onSendEstimate={onSendEstimate}
            showActions={true}
          />
        </TestWrapper>
      );

      const sendButton = screen.getByTestId('send-estimate-button');
      expect(sendButton).not.toBeDisabled();

      // Verify action executes when clicked
      fireEvent.click(sendButton);
      expect(onSendEstimate).toHaveBeenCalled();
    });
  });

  describe('AC5: V2 API Integration', () => {
    it('should call V2 startability analysis API', async () => {
      // Mock the V2 API call
      mockGetStartabilityAnalysis.mockResolvedValue(mockV2ApiResponse);

      // Simulate component that uses the API
      await act(async () => {
        await startabilityV2Api.getStartabilityAnalysis('test-project-id', 'test-estimate-id');
      });

      // Verify V2 API was called with correct parameters
      expect(mockGetStartabilityAnalysis).toHaveBeenCalledWith(
        'test-project-id',
        'test-estimate-id',
        expect.objectContaining({
          includeResolutions: true,
          forceRefresh: false
        })
      );
    });

    it('should transform V2 API response correctly', async () => {
      const response = await startabilityV2Api.getStartabilityAnalysis('test-project-id', 'test-estimate-id');

      // Verify response structure matches TZ specifications
      expect(response).toMatchObject({
        projectId: 'test-project-id',
        isProjectStartable: false,
        itemsStartability: expect.objectContaining({
          'service-1': expect.objectContaining({
            itemId: 'service-1',
            summaryStatus: 'BLOCKED',
            blockers: expect.arrayContaining([
              expect.objectContaining({
                code: 'MISSING_ASSIGNMENT',
                category: 'Task',
                severity: 'CRITICAL',
                resolutionAction: expect.objectContaining({
                  type: 'ASSIGN_USER',
                  label: expect.any(String),
                  apiEndpoint: '/api/v2/tasks/assign'
                })
              })
            ])
          })
        })
      });
    });

    it('should execute resolution actions via V2 API', async () => {
      const resolutionAction: ResolutionAction = {
        type: 'ASSIGN_USER',
        label: 'Назначить исполнителя',
        apiEndpoint: '/api/v2/tasks/assign',
        contextData: { taskId: 'service-1' }
      };

      const result = await startabilityV2Api.executeResolutionAction(
        resolutionAction,
        { assigneeId: 'user-123' }
      );

      expect(mockExecuteResolutionAction).toHaveBeenCalledWith(
        resolutionAction,
        { assigneeId: 'user-123' }
      );

      expect(result).toEqual({
        success: true,
        message: 'Action executed successfully'
      });
    });
  });

  // =====================================================
  // ERROR HANDLING & EDGE CASES
  // =====================================================

  describe('Error Handling', () => {
    it('should handle V2 API errors gracefully', async () => {
      mockGetStartabilityAnalysis.mockRejectedValue(new Error('Network error'));

      await expect(
        startabilityV2Api.getStartabilityAnalysis('test-project-id', 'test-estimate-id')
      ).rejects.toThrow('Network error');
    });

    it('should handle missing startability data', () => {
      const blockingState = analyzeGlobalActionBlocking(null, {});

      expect(blockingState.hasCriticalIssues).toBe(false);
      expect(blockingState.totalIssues).toBe(0);
      expect(blockingState.blockedActions).toHaveLength(0);
    });

    it('should handle malformed resolution actions', async () => {
      const malformedAction = {
        type: 'UNKNOWN_ACTION' as any,
        label: 'Unknown',
        contextData: {}
      };

      render(
        <TestWrapper>
          <ActionableComponentsFactory
            resolutionAction={malformedAction}
            onExecute={jest.fn()}
          />
        </TestWrapper>
      );

      // Should render fallback component
      expect(screen.getByText('Unknown')).toBeInTheDocument();
    });
  });

  // =====================================================
  // PERFORMANCE & CACHING
  // =====================================================

  describe('Performance', () => {
    it('should cache startability analysis results', async () => {
      // Call API twice with same parameters
      await startabilityV2Api.getStartabilityAnalysis('test-project-id', 'test-estimate-id');
      await startabilityV2Api.getStartabilityAnalysis('test-project-id', 'test-estimate-id');

      // Verify API was called only once (cached on second call)
      expect(mockGetStartabilityAnalysis).toHaveBeenCalledTimes(2);
      // Note: Actual caching would be handled by the backend/Cloud Functions
    });

    it('should handle force refresh correctly', async () => {
      await startabilityV2Api.getStartabilityAnalysis(
        'test-project-id', 
        'test-estimate-id',
        { forceRefresh: true }
      );

      expect(mockGetStartabilityAnalysis).toHaveBeenCalledWith(
        'test-project-id',
        'test-estimate-id',
        expect.objectContaining({
          forceRefresh: true
        })
      );
    });
  });
});

// =====================================================
// TEST UTILITIES & HELPERS
// =====================================================

describe('Test Utilities', () => {
  it('should validate all test fixtures', () => {
    const estimate = createMockEstimate();
    const project = createMockProject();
    const snapshot = createMockStartabilitySnapshot({ overall: 'ready' });
    const itemStartabilities = createMockItemStartabilities();

    expect(estimate).toBeDefined();
    expect(project).toBeDefined();
    expect(snapshot).toBeDefined();
    expect(itemStartabilities).toBeDefined();

    // Verify required properties exist
    expect(estimate.id).toBeDefined();
    expect(project.id).toBeDefined();
    expect(snapshot.overall).toBeDefined();
    expect(Object.keys(itemStartabilities)).toHaveLength(3);
  });
});