import React from 'react';
import { ThemeProvider } from '@mui/material/styles';
import { createTheme } from '@mui/material/styles';
import { MemoryRouter } from 'react-router-dom';
import { I18nextProvider } from 'react-i18next';
import i18n from 'i18next';
import { initReactI18next } from 'react-i18next';

// Types
import { 
  StartabilitySnapshot, 
  StartabilityReason,
  ItemStartability,
  StartabilityCode,
  StartabilityCategory,
  StartabilitySeverity 
} from '../../types/startability.types';
import { Estimate } from '../../types/estimate.types';
import { Project } from '../../types/project.types';

// =====================================================
// I18N SETUP FOR TESTS
// =====================================================

// Initialize i18n for tests
i18n
  .use(initReactI18next)
  .init({
    lng: 'ru',
    fallbackLng: 'ru',
    resources: {
      ru: {
        translation: {
          startability: {
            header: {
              blocked_send_tooltip: 'Нельзя отправить смету пока есть критические проблемы',
              blocked_convert_tooltip: 'Нельзя преобразовать в договор пока есть критические проблемы',
              send_estimate: 'Отправить клиенту',
              convert_contract: 'Преобразовать в договор'
            }
          }
        }
      }
    },
    interpolation: {
      escapeValue: false
    }
  });

// =====================================================
// MOCK THEME
// =====================================================

const testTheme = createTheme({
  palette: {
    primary: {
      main: '#2e7d32',
    },
    success: {
      main: '#4caf50',
    },
    warning: {
      main: '#ff9800',
    },
    error: {
      main: '#f44336',
    },
  },
});

// =====================================================
// TEST WRAPPER COMPONENT
// =====================================================

interface TestWrapperProps {
  children: React.ReactNode;
  initialRoute?: string;
}

export const TestWrapper: React.FC<TestWrapperProps> = ({ 
  children, 
  initialRoute = '/' 
}) => {
  return (
    <MemoryRouter initialEntries={[initialRoute]}>
      <ThemeProvider theme={testTheme}>
        <I18nextProvider i18n={i18n}>
          {children}
        </I18nextProvider>
      </ThemeProvider>
    </MemoryRouter>
  );
};

