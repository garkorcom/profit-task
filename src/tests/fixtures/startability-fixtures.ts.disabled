export function createMockStartabilitySnapshot(
  overrides: Partial<StartabilitySnapshot> = {}
): StartabilitySnapshot {
  const defaultReasons: StartabilityReason[] = [
    {
      code: 'MISSING_ASSIGNMENT',
      category: 'PERMISSIONS',
      message: 'Задача не назначена исполнителю',
      severity: 'critical',
      detectedAt: new Date(),
      autoResolvable: true,
      cta: 'ASSIGN_USER',
      meta: {
        projectId: 'test-project-id',
        estimateId: 'test-estimate-id',
        taskId: 'service-1',
        entityName: 'Монтаж системы отопления',
        suggestedAssignees: [
          { id: 'user-1', name: 'Иван Петров', role: 'Слесарь' },
          { id: 'user-2', name: 'Мария Иванова', role: 'Мастер' }
        ]
      }
    },
    {
      code: 'MISSING_COUNTERPARTY_APPROVAL',
      category: 'BUSINESS',
      message: 'Ожидается утверждение клиента',
      severity: 'warning',
      detectedAt: new Date(),
      autoResolvable: false,
      cta: 'REQUEST_APPROVAL',
      meta: {
        projectId: 'test-project-id',
        estimateId: 'test-estimate-id',
        clientId: 'test-client-id'
      }
    }
  ];

  return {
    projectId: 'test-project-id',
    estimateId: 'test-estimate-id',
    overall: 'blocked',
    reasons: defaultReasons,
    sampleBlockedItems: ['Монтаж системы отопления', 'Электромонтажные работы'],
    stats: {
      criticalCount: 1,
      warningCount: 1,
      infoCount: 0,
      startableItemCount: 1,
      totalItemCount: 3
    },
    evaluatedAt: new Date(),
    evaluatedBy: 'test-user-id',
    ttl: 300,
    ...overrides
  };
}

