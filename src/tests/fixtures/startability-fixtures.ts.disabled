// =====================================================
// TEST DATA VALIDATION
// =====================================================

export function validateTestFixtures(): boolean {
  try {
    const estimate = createMockEstimate();
    const project = createMockProject();
    const snapshot = createMockStartabilitySnapshot();
    const itemStartabilities = createMockItemStartabilities();

    // Basic validation
    if (!estimate.id || !project.id || !snapshot.projectId) {
      console.error('Test fixtures missing required IDs');
      return false;
    }

    if (!estimate.blocks || estimate.blocks.length === 0) {
      console.error('Mock estimate missing blocks');
      return false;
    }

    if (!snapshot.reasons || snapshot.reasons.length === 0) {
      console.error('Mock snapshot missing reasons');
      return false;
    }

    if (Object.keys(itemStartabilities).length === 0) {
      console.error('Mock item startabilities empty');
      return false;
    }

    return true;
  } catch (error) {
    console.error('Test fixtures validation failed:', error);
    return false;
  }
}

// =====================================================
// EXPORTS
// =====================================================

export default {
  TestWrapper,
  createMockEstimate,
  createMockProject,
  createMockStartabilitySnapshot,
  createMockItemStartabilities,
  createMockReason,
  mockV2StartabilityResponse,
  mockUsers,
  mockClients,
  validateTestFixtures
};