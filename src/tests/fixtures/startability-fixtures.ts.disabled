// =====================================================
// MOCK REASON HELPERS
// =====================================================

export function createMockReason(
  code: StartabilityCode,
  severity: StartabilitySeverity = 'warning',
  category: StartabilityCategory = 'TASKS',
  overrides: Partial<StartabilityReason> = {}
): StartabilityReason {
  return {
    code,
    category,
    message: `Mock reason for ${code}`,
    severity,
    detectedAt: new Date(),
    autoResolvable: false,
    ...overrides
  };
}

